# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/tripmate

# Session
SESSION_SECRET=replace_this_with_a_long_random_string

# Email (Nodemailer - use an app password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="TripMate <no-reply@tripmate.com>"

# AI (Gemini API - https://ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key

# Maps (Google Maps Platform - https://console.cloud.google.com)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Media uploads (Cloudinary - https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

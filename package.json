{
  "name": "tripmate",
  "version": "1.0.0",
  "description": "TripMate — AI-Powered Collaborative Trip Planner (Monorepo)",
  "scripts": {
    "install-all": "cd backend && npm install && cd ../frontend && npm install",
    "render-build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend",
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["tripmate", "travel", "mern", "ai", "collaborative"],
  "license": "ISC"
}
